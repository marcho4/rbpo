":"High","urls":[],"description":"Starlette vulnerable to O(n^2) DoS via Range header merging in ``starlette.responses.FileResponse``","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-62727","epss":0.00509,"percentile":0.65451,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2025-62727","cwe":"CWE-407","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["0.49.1"],"state":"fixed","available":[{"version":"0.49.1","date":"2025-10-29","kind":"first-observed"}]},"advisories":[],"risk":0.38175},"relatedVulnerabilities":[{"id":"CVE-2025-62727","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-62727","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/Kludex/starlette/commit/4ea6e22b489ec388d6004cfbca52dd5b147127c5","https://github.com/Kludex/starlette/commit/69ed26a85956ef4bd0161807eb27abf49be7cd3c","https://github.com/Kludex/starlette/releases/tag/0.49.1","https://github.com/Kludex/starlette/security/advisories/GHSA-7f5h-v6xp-fcq8"],"description":"Starlette is a lightweight ASGI framework/toolkit. Starting in version 0.39.0 and prior to version 0.49.1 , an unauthenticated attacker can send a crafted HTTP Range header that triggers quadratic-time processing in Starlette's FileResponse Range parsing/merging logic. This enables CPU exhaustion per request, causing denial‑of‑service for endpoints serving files (e.g., StaticFiles or any use of FileResponse). This vulnerability is fixed in 0.49.1.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-62727","epss":0.00509,"percentile":0.65451,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2025-62727","cwe":"CWE-407","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-7f5h-v6xp-fcq8","versionConstraint":">=0.39.0,<=0.49.0 (python)"},"fix":{"suggestedVersion":"0.49.1"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=2299e7a14c11b7ae","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-59g5-xgcq-4qw3","dataSource":"https://github.com/advisories/GHSA-59g5-xgcq-4qw3","namespace":"github:language:python","severity":"High","urls":[],"description":"Denial of service (DoS) via deformation `multipart/form-data` boundary","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-53981","epss":0.00346,"percentile":0.5644,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2024-53981","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["0.0.18"],"state":"fixed","available":[{"version":"0.0.18","date":"2024-12-03","kind":"first-observed"}]},"advisories":[],"risk":0.2595},"relatedVulnerabilities":[{"id":"CVE-2024-53981","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2024-53981","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/Kludex/python-multipart/commit/c4fe4d3cebc08c660e57dd709af1ffa7059b3177","https://github.com/Kludex/python-multipart/security/advisories/GHSA-59g5-xgcq-4qw3"],"description":"python-multipart is a streaming multipart parser for Python. When parsing form data, python-multipart skips line breaks (CR \\r or LF \\n) in front of the first boundary and any tailing bytes after the last boundary. This happens one byte at a time and emits a log event each time, which may cause excessive logging for certain inputs. An attacker could abuse this by sending a malicious request with lots of data before the first or after the last boundary, causing high CPU load and stalling the processing thread for a significant amount of time. In case of ASGI application, this could stall the event loop and prevent other requests from being processed, resulting in a denial of service (DoS). This vulnerability is fixed in 0.0.18.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-53981","epss":0.00346,"percentile":0.5644,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2024-53981","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"python-multipart","version":"0.0.12"}},"found":{"vulnerabilityID":"GHSA-59g5-xgcq-4qw3","versionConstraint":"<0.0.18 (python)"},"fix":{"suggestedVersion":"0.0.18"}}],"artifact":{"id":"pkg:pypi/python-multipart@0.0.12?package-id=2fca72833520e888","name":"python-multipart","version":"0.0.12","type":"python","locations":[{"path":"/requirements.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:fastapiexpert:python-multipart:0.0.12:*:*:*:*:python:*:*"],"purl":"pkg:pypi/python-multipart@0.0.12","upstreams":[]}},{"vulnerability":{"id":"GHSA-cjwg-qfpm-7377","dataSource":"https://github.com/advisories/GHSA-cjwg-qfpm-7377","namespace":"github:language:python","severity":"Medium","urls":[],"description":"python-jose denial of service via compressed JWE content","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-33664","epss":0.00194,"percentile":0.41425,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2024-33664","cwe":"CWE-400","source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2025-02-19","kind":"first-observed"}]},"advisories":[],"risk":0.09991000000000001},"relatedVulnerabilities":[{"id":"CVE-2024-33664","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2024-33664","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/mpdavis/python-jose/issues/344","https://github.com/mpdavis/python-jose/pull/345","https://www.vicarius.io/vsociety/posts/jwt-bomb-in-python-jose-cve-2024-33664"],"description":"python-jose through 3.3.0 allows attackers to cause a denial of service (resource consumption) during a decode via a crafted JSON Web Encryption (JWE) token with a high compression ratio, aka a \"JWT bomb.\" This is similar to CVE-2024-21319.","cvss":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-33664","epss":0.00194,"percentile":0.41425,"date":"2025-12-04"}],"cwes":[{"cve":"CVE-2024-33664","cwe":"CWE-400","source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"python-jose","version":"3.3.0"}},"found":{"vulnerabilityID":"GHSA-cjwg-qfpm-7377","versionConstraint":"<3.4.0 (python)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"pkg:pypi/python-